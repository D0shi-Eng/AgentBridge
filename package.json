    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "prepare-restricted-role": "node scripts/prepare-restricted-role.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",

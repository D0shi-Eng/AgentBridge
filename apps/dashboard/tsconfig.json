{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2022"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "noEmit": true,
    "incremental": true,
    "allowJs": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "node",
      "@testing-library/jest-dom"
    ]
  },
  "include": [
    ".next-isolated1/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "src",
    ".next-isolated2/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}

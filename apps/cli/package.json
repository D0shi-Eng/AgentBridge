{
  "name": "@agentbridge/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "agentbridge": "./src/main.ts",
    "agentbridge-ops": "./src/ops/ops-main.ts"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",

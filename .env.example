# مرجع متغيرات البيئة — انسخ إلى .env واملأ القيم
# ممنوع وضع قيم حقيقية في هذا الملف أو في أي ملف داخل Git

# البيئة: development | test | production
NODE_ENV=development

# منفذ واجهة API
PORT=3000

# مستوى السجلات: debug | info | warn | error
LOG_LEVEL=info

# قاعدة البيانات (PostgreSQL + pgvector)
# مع docker-compose.dev.yaml: postgresql://agentbridge:agentbridge@localhost:5433/agentbridge
DATABASE_URL=postgresql://user:password@localhost:5432/agentbridge

# الذاكرة العرضية (Redis)
# مع docker-compose.dev.yaml: redis://localhost:6380
REDIS_URL=redis://localhost:6379

# نمط التخزين: memory (افتراضي — محولات داخل الذاكرة للتطوير والاختبار)
# أو live (يقلع فوق PostgreSQL+Redis الحيّتين عبر Prisma/node-redis)
PERSISTENCE=memory

# مفتاح التشفير AES-256-GCM — 32 بايت بترميز base64 (إلزامي في الإنتاج)
ENCRYPTION_KEY=

# مزودو النماذج — يُفعَّل المستخدم فقط منها
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# المزود الافتراضي: anthropic | openai | mock
LLM_PROVIDER=mock

# سقف تكلفة شهري بالدولار لكل مستأجر (درع تجاوز التكلفة)
LLM_MONTHLY_BUDGET_USD=50

# قائمة مشغل موثوق: أسماء مضيفين دقيقة مفصولة بفواصل، HTTPS/443 فقط؛ الفراغ يعطل جلب JWKS.
# Trusted operator allowlist: exact comma-separated hosts; empty disables JWKS fetching.
JWKS_ALLOWED_HOSTS=

# أصل لوحة المتصفح وcallback ثابتان؛ لا يبنيهما الخادم من Host أو forwarded headers.
APP_ORIGIN=http://127.0.0.1:3001
OIDC_REDIRECT_URI=http://127.0.0.1:3000/auth/oidc/callback

# بيئة HTTPS التدريبية: تفرض كوكيز شكل الإنتاج (__Host- + Secure) وHSTS
# فوق TLS محلي. "0" افتراضي — أي شيء آخر غير "0"/"1" يرفض الإقلاع.
STAGING_HTTPS=0

# فئات الفحص الحي — قرار خادم موثوق حصراً، والافتراضي "0" مغلق fail-closed:
# بلا فئات حية تنتهي تشغيلات المنصة بالرفض الموثق LIVE_EVIDENCE_MISSING ولا
# تُمنح شهادة. AGENTBRIDGE_LIVE_PROBES=1 يفعّل الفحص الحي الحقيقي للخادم
# المولد، وAGENTBRIDGE_SANDBOX_PROBES=1 يقصر إقلاعه على حاوية العزل المعزولة
# (بلا شبكة، قراءة فقط، غير root) بدل المضيف — يلزم مع تفعيل الفئات الحية.
AGENTBRIDGE_LIVE_PROBES=0
AGENTBRIDGE_SANDBOX_PROBES=0

# ── مفاتيح التوقيع الثلاثة (Ed25519 PKCS8 بترميز base64) ──
# الإنتاج يرفض الإقلاع بلا الثلاثة (لا مفتاح عابر لكل restart).
# توليد زوج: node -e "const{generateKeyPairSync}=require('crypto');const{privateKey,publicKey}=generateKeyPairSync('ed25519');console.log(privateKey.export({format:'der',type:'pkcs8'}).toString('base64'))"
# ORCH_SNAPSHOT_PRIVATE_KEY: توقيع snapshots الاستئناف — الثبات شرط الاستئناف بعد restart
ORCH_SNAPSHOT_PRIVATE_KEY=
# ORCH_SNAPSHOT_VERIFY_PUBLIC_KEYS: مفاتيح عامة سابقة (SPKI base64 مفصولة بفواصل)
# لتحقق الدوران قراءةً فقط — الإصدار يبقى بالمفتاح الحالي حصراً، والقديم يُقبل
# حتى تنتهي صلاحية ما وقّع به (7 أيام افتراضياً)
ORCH_SNAPSHOT_VERIFY_PUBLIC_KEYS=
# CERT_SIGNING_PRIVATE_KEY: توقيع شهادات "Agent-Ready Verified" الصادرة من الأنبوب
CERT_SIGNING_PRIVATE_KEY=
# CERT_SIGNING_VERIFY_PUBLIC_KEYS: مفاتيح شهادة عامة سابقة
# (SPKI base64 بفواصل) لنافذة الدوران — /verify يتحقق بأي مفتاح معروف فيها
CERT_SIGNING_VERIFY_PUBLIC_KEYS=
# CERT_SIGNING_REVOKED_KEY_IDS: keyIds ملغاة (hex16 مفصولة
# بفواصل) — توقيع شهادة بأحد الخادم يجعل التحقق العام يرد بسبب revoked موثق
CERT_SIGNING_REVOKED_KEY_IDS=
# HITL_SIGNING_PRIVATE_KEY: توقيع تذاكر الموافقة البشرية — ثابت بين النسخ
HITL_SIGNING_PRIVATE_KEY=

# ── مزود مفاتيح التشفير (KMS) ──
# "local" هو الوحيد المنفَّذ (مزود ثابت محلي للتطوير/الاختبار) — الإنتاج
# يرفض الإقلاع به صراحةً: لا يوجد مزود KMS خارجي معتمد بعد
# (EXTERNAL_KMS = NOT_VERIFIED). عند اعتماد مزود خارجي لاحقاً يتوسع هذا الحقل.
KMS_PROVIDER=local

# ── سياسة الاحتفاظ (إلزامية في الإنتاج — fail-closed) ──
# JSON بسطر واحد: episodicEventsDays/signedSnapshotsDays بالأيام (1-3650)،
# وrunArchives/certificates/artifacts رقم أيام أو "permanent"، وauditLog
# دائم حصراً ("permanent" فقط — سلسلة الهاش إلحاق-only). التطوير يستخدم
# سياسة افتراضية موثقة (7/7/permanent…) لا تُورث للإنتاج إطلاقاً. مثال:
# السياسة الآن لكل صنف بيانات حقل مستقل. الأصناف المطلوبة كاملة:
# episodicEventsDays/signedSnapshotsDays (أيام) · runArchives/certificates/artifacts/sessions/
# loginTransactions/operationalLogs/backups/memoryVector/flywheelLessons (أيام أو "permanent") ·
# revocations/auditLog="permanent" حصراً · semanticCore/ssoConfig="tenant-lifetime" · memoryWorking="ephemeral"
# RETENTION_POLICY_JSON={"episodicEventsDays":7,"signedSnapshotsDays":7,"runArchives":"permanent","certificates":"permanent","artifacts":"permanent","auditLog":"permanent","revocations":"permanent","semanticCore":"tenant-lifetime","sessions":"permanent","loginTransactions":"permanent","operationalLogs":"permanent","backups":"permanent","memoryWorking":"ephemeral","memoryVector":"permanent","flywheelLessons":"permanent","ssoConfig":"tenant-lifetime"}
RETENTION_POLICY_JSON=

# ── اتصال المشغّل لأوامر الإدارة (agentbridge-ops) ──
# يُستهلك للعد الإداري في حارس bootstrap الأول حصراً — لا كتابة إدارية تمر عبره.
# غيابه مع --initial يرفض fail-closed. لا يوضع أبداً في وسائط الأوامر.
ADMIN_DATABASE_URL=

# ── معاملات سقف حجز الميزانية (تقنية محافظة — ليست تسعيراً تجارياً) ──
# السقف لكل نداء = max(LLM_RESERVATION_MIN_USD، أحرف الطلب/1000 × السعر-التقني × المعامل).
# سياسة التسعير التجارية الفعلية قرار إداري منفصل موثق — هذه القيم ضابط موارد لا سياسة أسعار.
LLM_RESERVATION_CEILING_FACTOR=2
LLM_RESERVATION_PRICE_USD_PER_1K_CHARS=0.002
LLM_RESERVATION_MIN_USD=0.01

# ── حماية /metrics (نفس التوكن السابق؛ المقارنة ثابتة الزمن) ──
METRICS_TOKEN=

# ── جلسة الوضع المحلي الفردي (تثبيت جهاز واحد — استثناء موثق في security.md §9) ──
# LOCAL_BOOTSTRAP=1 يفعّل تأسيس جلسة تلقائية للوحة على 127.0.0.1 حصراً:
# فتح /app يؤسس الجلسة بلا شاشة مفتاح. الحواجز: Origin=APP_ORIGIN حرفياً
# + مضيفو الحلقة حصراً + ترويسة عميل اللوحة المخصصة. مصادقة API بالمفتاح
# باقية كاملة لأي وصول برمجي ولكل وضع آخر. القيم اللاحقة إلزامية عند التفعيل
# (رفض إقلاع بغيرها) ويعينها سكربت setup في التثبيت المحلي:
LOCAL_BOOTSTRAP=0
LOCAL_TENANT_ID=
LOCAL_CREDENTIAL_ID=

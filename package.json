{
  "name": "agentbridge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "description": "AgentBridge converts OpenAPI 3.x specifications into reviewable MCP servers with isolated security checks and verifiable evidence. | يحوّل AgentBridge مواصفات OpenAPI 3.x إلى خوادم MCP قابلة للمراجعة، مع فحوص أمنية معزولة وأدلة تحقق موثوقة.",
  "repository": {
    "type": "git",
    "url": "https://github.com/D0shi-Eng/AgentBridge.git"
  },
  "bugs": {
    "url": "https://github.com/D0shi-Eng/AgentBridge/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {

{
  "name": "@agentbridge/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./container": "./src/container.ts",
    "./test-helpers": "./src/test-helpers.ts"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@agentbridge/evaluator": "workspace:*",
    "@agentbridge/hardening": "workspace:*",
    "@agentbridge/infra": "workspace:*",
    "@agentbridge/llm": "workspace:*",
    "@agentbridge/memory": "workspace:*",
    "@agentbridge/orchestrator": "workspace:*",
    "@agentbridge/shared": "workspace:*",
    "@prisma/client": "6.19.3",
    "fastify": "^5.12.1",
    "redis": "6.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "license": "Apache-2.0"
}
